# Nginx
## Network
HTTP_PORT=80
HTTPS_PORT=443
NGINX_CLIENT_MAX_BODY_SIZE=64m
NGINX_PROXY_READ_TIMEOUT=300s

## Resources
NGINX_MEMORY_LIMIT=64m

# Web
## Resources
WEB_MEMORY_LIMIT=64m

# API
## Account
ACCOUNT_USERNAME=administrator@example.com
ACCOUNT_NICKNAME=Administrator
ACCOUNT_PASSWORD=

## Upstream
### OpenAI
OPENAI_RESPONSES_URL=https://chatgpt.com/backend-api/codex/responses
OPENAI_REQUEST_TIMEOUT=300

### Gateway
PROFILE_RESPONSES_MAX_ATTEMPTS=3
PROFILE_CAPACITY_MAX_RETRIES=3
PROFILE_CAPACITY_RETRY_MIN_DELAY=PT1S
PROFILE_CAPACITY_RETRY_MAX_DELAY=PT30S

## Profiles
### Runtime
CODEX_EXECUTABLE=codex

### Storage
CODEX_PROFILES_ROOT=/data/codex-profiles

### Scheduling
PROFILE_ERROR_COOLDOWN=PT60S
PROFILE_SCORE_TOLERANCE=0.05
PROFILE_AFFINITY_TTL_DAYS=30

## Sessions
### Lifetime
SESSION_TTL_DAYS=30

### Cookie
SESSION_COOKIE_SECURE=true

## Resources
API_MEMORY_LIMIT=384m

# Worker
## Runtime
### Pool
WORKER_CONCURRENCY=2
WORKER_MAX_TASKS_PER_CHILD=24

## Tasks
### Profiles
PROFILE_TASK_MAX_RETRIES=2
PROFILE_TASK_MIN_RETRY_DELAY=5
PROFILE_TASK_MAX_RETRY_DELAY=30
PROFILE_TASK_LEASE_TTL=PT6H

## Resources
WORKER_MEMORY_LIMIT=1024m

# Beat
## Resources
BEAT_MEMORY_LIMIT=96m

# Redis
## Connection
REDIS_HOST=redis
REDIS_PORT=6379

### Databases
REDIS_BROKER_DATABASE=0

## Authentication
REDIS_USERNAME=codex-profiles
REDIS_PASSWORD=

## Storage
REDIS_MAXMEMORY=128mb

## Resources
REDIS_MEMORY_LIMIT=192m

# PostgreSQL
## Connection
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=codex-profiles
POSTGRES_MAX_CONNECTIONS=30

## Authentication
POSTGRES_USERNAME=codex-profiles
POSTGRES_PASSWORD=

## Memory
POSTGRES_SHARED_BUFFERS=128MB
POSTGRES_WORK_MEM=1MB
POSTGRES_MAINTENANCE_WORK_MEM=32MB

## Resources
POSTGRES_MEMORY_LIMIT=192m
