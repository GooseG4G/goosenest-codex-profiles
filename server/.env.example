# PostgreSQL Config
## Connection
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=codex-profiles

## Authentication
POSTGRES_USERNAME=codex-profiles
POSTGRES_PASSWORD=

# Bootstrap Administrator Config
## Identity
BOOTSTARTUP_USERNAME=administrator@example.com
BOOTSTARTUP_NICKNAME=Administrator

## Authentication
BOOTSTARTUP_PASSWORD=

# Server Config
## Ports
HTTP_PORT=80
HTTPS_PORT=443

# OpenAI Config
## Connection
OPENAI_RESPONSES_URL=https://chatgpt.com/backend-api/codex/responses

## Timeouts
OPENAI_REQUEST_TIMEOUT=300

# Codex Config
## Runtime
CODEX_EXECUTABLE=codex

## Storage
CODEX_PROFILES_ROOT=/data/codex-profiles

## Scheduling
PROFILE_WEEKLY_RESERVE_PERCENT=25
PROFILE_SCORE_TOLERANCE=0.05

# Session Config
## Lifetime
SESSION_TTL_DAYS=30

## Cookie
SESSION_COOKIE_SECURE=true

# Redis Config
## Connection
REDIS_HOST=redis
REDIS_PORT=6379

## Authentication
REDIS_USERNAME=codex-profiles
REDIS_PASSWORD=

## Databases
REDIS_BROKER_DATABASE=0
REDIS_BACKEND_DATABASE=1

# Usage Task Config
## Retries
USAGE_TASK_MAX_RETRIES=2
USAGE_TASK_MIN_RETRY_DELAY=5
USAGE_TASK_MAX_RETRY_DELAY=30
