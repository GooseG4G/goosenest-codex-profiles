{
  "name": "codex-profiles",
  "displayName": "Codex Profiles",
  "description": "Switch Codex accounts, view usage limits, and manage compatible providers from VS Code",
  "version": "1.2.1",
  "publisher": "goosenest",
  "repository": {
    "type": "git",
    "url": "https://github.com/GooseG4G/goosenest-codex-profiles.git"
  },
  "homepage": "https://github.com/GooseG4G/goosenest-codex-profiles#readme",
  "bugs": {
    "url": "https://github.com/GooseG4G/goosenest-codex-profiles/issues"
  },
  "keywords": [
    "codex",
    "profiles",
    "accounts",
    "authentication",
    "usage limits"
  ],
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:codexProfiles.profilesView"
  ],
  "main": "./src/extension.js",
  "icon": "images/icon.png",
  "files": [
    "src",
    "build/dist",
    "images",
    "node_modules/graceful-fs",
    "node_modules/proper-lockfile",
    "node_modules/retry",
    "node_modules/signal-exit",
    "node_modules/ws",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "check": "vue-tsc --noEmit",
    "test": "node --test test/*.test.js",
    "test:vue": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "package": "vsce package --githubBranch main"
  },
  "contributes": {
    "commands": [
      {
        "command": "codexProfiles.open",
        "title": "Codex Profiles: Open",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "codexProfiles.refresh",
        "title": "Codex Profiles: Refresh",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "codexProfiles",
          "title": "Codex Profiles",
          "icon": "images/switch.svg"
        }
      ]
    },
    "views": {
      "codexProfiles": [
        {
          "type": "webview",
          "id": "codexProfiles.profilesView",
          "name": "Profiles"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "codexProfiles.refresh",
          "when": "view == codexProfiles.profilesView",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "codexProfiles.open",
          "when": "editorIsOpen",
          "group": "navigation@50"
        }
      ]
    },
    "configuration": {
      "title": "Codex Profiles",
      "properties": {
        "codexProfiles.codexHome": {
          "type": "string",
          "default": "",
          "description": "Codex directory. When empty, ~/.codex is used."
        }
      }
    }
  },
  "devDependencies": {
    "@types/vscode": "^1.106.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vscode/vsce": "^3.6.2",
    "@playwright/test": "^1.64.1",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.1.0"
  },
  "dependencies": {
    "@lucide/vue": "^1.65.0",
    "proper-lockfile": "^4.1.2",
    "vue": "^3.5.22",
    "ws": "^8.18.3"
  }
}
